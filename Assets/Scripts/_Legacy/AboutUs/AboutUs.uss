.about-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Scripts/LandingPage/AboutUs/AboutBG.png");
    -unity-background-scale-mode: scale-and-crop;
}

.spacer {
    flex-grow: 1;
}

.footer {
    width: 100%;
    align-items: center;
    padding-bottom: 5%;
}

.back-button {
    width: 40%;
    height: 60px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.2);
    color: white;
    -unity-font-style: bold;
}
