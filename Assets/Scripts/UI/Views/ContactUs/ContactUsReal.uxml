<?xml version="1.0" encoding="utf-8"?>
<!--
    sReader — Contact Us Page (Huawei Y5 · 720×1520 · relative units)
    ───────────────────────────────────────────────────────────────────
    Same sizing strategy as RegisterReal.uxml:
        Header      16%  of screen height
        Form        flex-grow:1 (rows spaced evenly)
        Bottom bar   9%  of screen height
    Only px values are font sizes, hairlines and corner radii.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">

    <!-- Cursor/selection colors for text inputs (C# setters are obsolete) -->
    <ui:Style src="project://database/Assets/Scripts/UI/Views/Shared/AuthFields.uss" />

    <!-- Page root: fills the panel completely -->
    <ui:VisualElement name="page-root"
        style="width: 100%; height: 100%; background-color: rgb(18, 20, 25); padding-left: 6%; padding-right: 6%; padding-top: 3%; padding-bottom: 1.5%;">

        <!-- ── Zone 1 · Header — 16% of screen height ── -->
        <ui:VisualElement name="header"
            style="flex-shrink: 0; justify-content: flex-end; align-items: center; padding-top: 52px; padding-bottom: 14px;">

            <!-- Back button hanging in the top-left corner -->
            <ui:Button name="back-button" text="‹ Back"
                style="position: absolute; top: 8px; left: 0; background-color: rgba(0, 0, 0, 0); color: rgb(233, 223, 200); font-size: 16px; -unity-font-style: bold; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 0; padding-right: 16px; padding-top: 10px; padding-bottom: 10px; margin-left: 0;" />

            <!-- Signature bookmark ribbon hanging from the top edge -->
            <ui:VisualElement name="bookmark-ribbon"
                style="position: absolute; top: 0; right: 2%; width: 4.5%; height: 44px; background-color: rgb(233, 223, 200); border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;" />

            <ui:Label name="wordmark" text="sReader"
                style="font-size: 36px; color: rgb(242, 239, 230); -unity-font-style: bold; letter-spacing: 3px;" />
            <ui:VisualElement name="title-rule"
                style="height: 1px; width: 11%; background-color: rgb(233, 223, 200); margin-top: 1.5%; margin-bottom: 2%;" />
            <ui:Label name="subtitle" text="We'd love to hear from you."
                style="font-size: 14px; color: rgb(152, 160, 174); -unity-text-align: middle-center; white-space: normal;" />
        </ui:VisualElement>

        <!-- ── Zone 2 · Form — fills all remaining height, rows spaced evenly ── -->
        <ui:VisualElement name="form"
            style="flex-grow: 1; justify-content: space-evenly;">

            <!-- Full name -->
            <ui:TextField name="full-name" placeholder-text="Your name"
                style="height: 48px; margin-left: 0; margin-right: 0; justify-content: center; background-color: rgb(35, 39, 51); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 2%; padding-right: 2%; color: rgb(242, 239, 230); font-size: 16px;" />

            <!-- Email -->
            <ui:TextField name="email" placeholder-text="Email address" keyboard-type="EmailAddress"
                style="height: 48px; margin-left: 0; margin-right: 0; justify-content: center; background-color: rgb(35, 39, 51); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 2%; padding-right: 2%; color: rgb(242, 239, 230); font-size: 16px;" />

            <!-- Subject -->
            <ui:TextField name="subject" placeholder-text="Subject"
                style="height: 48px; margin-left: 0; margin-right: 0; justify-content: center; background-color: rgb(35, 39, 51); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 2%; padding-right: 2%; color: rgb(242, 239, 230); font-size: 16px;" />

            <!-- Message — taller, multiline -->
            <ui:TextField name="message" placeholder-text="How can we help?" multiline="true"
                style="height: 132px; margin-left: 0; margin-right: 0; background-color: rgb(35, 39, 51); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 2%; padding-right: 2%; padding-top: 1.5%; color: rgb(242, 239, 230); font-size: 16px; white-space: normal;" />

            <!-- Hint + (hidden) status slots -->
            <ui:VisualElement name="messages">
                <ui:Label name="contact-hint" text="We usually reply within one school day."
                    style="font-size: 14px; color: rgb(122, 130, 145); white-space: normal;" />
                <ui:Label name="error-label" text=""
                    style="font-size: 14px; color: rgb(224, 122, 113); white-space: normal; display: none;" />
                <ui:Label name="success-label" text=""
                    style="font-size: 14px; color: rgb(233, 223, 200); white-space: normal; display: none;" />
            </ui:VisualElement>

            <!-- Primary action -->
            <ui:Button name="send-button" text="Send message"
                style="height: 52px; background-color: rgb(233, 223, 200); color: rgb(18, 20, 25); font-size: 16px; -unity-font-style: bold; letter-spacing: 1px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; margin-left: 0; margin-right: 0;" />

            <!-- Divider -->
            <ui:VisualElement name="divider-row" style="flex-direction: row; align-items: center;">
                <ui:VisualElement style="flex-grow: 1; height: 1px; background-color: rgb(46, 51, 64);" />
                <ui:Label text="or reach us directly" style="color: rgb(122, 130, 145); font-size: 14px; margin-left: 2%; margin-right: 2%;" />
                <ui:VisualElement style="flex-grow: 1; height: 1px; background-color: rgb(46, 51, 64);" />
            </ui:VisualElement>

            <!-- Direct contact details -->
            <ui:VisualElement name="direct-contact" style="align-items: center;">
                <ui:Label name="contact-email" text="hello@sreader.app"
                    style="font-size: 16px; color: rgb(242, 239, 230); -unity-font-style: bold; letter-spacing: 1px;" />
                <ui:Label name="contact-hours" text="Support hours · Mon–Fri, 8:00–17:00"
                    style="font-size: 14px; color: rgb(152, 160, 174); margin-top: 1%;" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ── Zone 3 · Bottom bar — 9% of screen height ── -->
        <ui:VisualElement name="bottom-bar"
            style="height: 9%; flex-shrink: 0; justify-content: center; align-items: center; border-top-width: 1px; border-top-color: rgb(35, 39, 51);">
            <ui:VisualElement name="trial-row" style="flex-direction: row; align-items: center;">
                <ui:Label text="New to sReader?" style="color: rgb(152, 160, 174); font-size: 14px;" />
                <ui:Button name="get-started-button" text="Start free trial"
                    style="background-color: rgba(0, 0, 0, 0); color: rgb(233, 223, 200); font-size: 14px; -unity-font-style: bold; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 4px; padding-right: 0; margin-left: 2px; margin-right: 0;" />
            </ui:VisualElement>
            <ui:Label name="footer" text="sReader · read anywhere"
                style="color: rgb(90, 97, 110); font-size: 12px; letter-spacing: 2px; margin-top: 1%;" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
