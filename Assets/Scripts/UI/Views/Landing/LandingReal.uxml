<?xml version="1.0" encoding="utf-8"?>
<!--
    sReader — Landing Page (Huawei Y5 · 720×1520 · relative units)
    ───────────────────────────────────────────────────────────────────
    Three-zone layout — no scrolling, content is paginated like a game:
        Header      auto height (flex-shrink 0 — never crushed)
        Pages       flex-grow:1 — one centered screen at a time,
                    ‹ › arrows + dots page sideways (see UIPager.cs)
        Bottom bar   9% of screen height (flex-shrink 0)
    px values ≈ dp (PanelSettings reference resolution 360×800, match width).
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">

    <!-- Page root: fills the panel completely -->
    <ui:VisualElement name="page-root"
        style="width: 100%; height: 100%; background-color: rgb(18, 20, 25); padding-left: 6%; padding-right: 6%; padding-top: 3%; padding-bottom: 1.5%;">

        <!-- ── Zone 1 · Header ── -->
        <ui:VisualElement name="header"
            style="flex-shrink: 0; justify-content: flex-end; align-items: center; padding-top: 52px; padding-bottom: 14px;">

            <!-- Signature bookmark ribbon hanging from the top edge -->
            <ui:VisualElement name="bookmark-ribbon"
                style="position: absolute; top: 0; right: 2%; width: 4.5%; height: 44px; background-color: rgb(233, 223, 200); border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;" />

            <ui:Label name="wordmark" text="sReader"
                style="font-size: 36px; color: rgb(242, 239, 230); -unity-font-style: bold; letter-spacing: 3px;" />
            <ui:VisualElement name="title-rule"
                style="height: 1px; width: 11%; background-color: rgb(233, 223, 200); margin-top: 1.5%; margin-bottom: 2%;" />
            <ui:Label name="subtitle" text="Reading, scheduled. Every sentence, understood."
                style="font-size: 14px; color: rgb(152, 160, 174); -unity-text-align: middle-center; white-space: normal;" />
        </ui:VisualElement>

        <!-- ── Zone 2 · Pages — one screen at a time, never scrolls ── -->
        <ui:VisualElement name="pager-pages" style="flex-grow: 1;">

            <!-- Page 1 · Welcome + actions -->
            <ui:VisualElement name="page-welcome" style="flex-grow: 1; justify-content: center;">
                <ui:Label name="hero-line" text="Where students, parents, teachers and tutors read together."
                    style="font-size: 22px; color: rgb(242, 239, 230); -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; margin-bottom: 4%;" />
                <ui:Label name="trial-note" text="A paid service for schools and families — start with a free trial."
                    style="font-size: 14px; color: rgb(122, 130, 145); -unity-text-align: middle-center; white-space: normal; margin-bottom: 8%;" />
                <ui:Button name="get-started-button" text="Start free trial"
                    style="height: 52px; background-color: rgb(233, 223, 200); color: rgb(18, 20, 25); font-size: 16px; -unity-font-style: bold; letter-spacing: 1px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; margin-bottom: 3%;" />
                <ui:Button name="signin-button" text="Sign in"
                    style="height: 48px; background-color: rgba(0, 0, 0, 0); color: rgb(242, 239, 230); font-size: 16px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64);" />
            </ui:VisualElement>

            <!-- Page 2 · Scheduled reading -->
            <ui:VisualElement name="page-scheduled" style="flex-grow: 1; justify-content: center; display: none;">
                <ui:VisualElement name="feature-scheduled"
                    style="background-color: rgb(35, 39, 51); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 18px; padding-right: 18px; padding-top: 18px; padding-bottom: 20px;">
                    <ui:Label text="Scheduled reading"
                        style="font-size: 18px; color: rgb(233, 223, 200); -unity-font-style: bold; white-space: normal;" />
                    <ui:Label text="Tutors plan, schedule and guide reading assignments — so every student reads on time, every time."
                        style="font-size: 14px; color: rgb(152, 160, 174); white-space: normal; margin-top: 2%;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Page 3 · Multiplayer reading -->
            <ui:VisualElement name="page-multiplayer" style="flex-grow: 1; justify-content: center; display: none;">
                <ui:VisualElement name="feature-multiplayer"
                    style="background-color: rgb(35, 39, 51); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 18px; padding-right: 18px; padding-top: 18px; padding-bottom: 20px;">
                    <ui:Label text="Read together, online"
                        style="font-size: 18px; color: rgb(233, 223, 200); -unity-font-style: bold; white-space: normal;" />
                    <ui:Label text="Multiplayer reading rooms where students discuss and understand with classmates — or play solo at their own pace."
                        style="font-size: 14px; color: rgb(152, 160, 174); white-space: normal; margin-top: 2%;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Page 4 · Understanding first -->
            <ui:VisualElement name="page-understanding" style="flex-grow: 1; justify-content: center; display: none;">
                <ui:VisualElement name="feature-understanding"
                    style="background-color: rgb(35, 39, 51); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 18px; padding-right: 18px; padding-top: 18px; padding-bottom: 20px;">
                    <ui:Label text="Understanding, sentence by sentence"
                        style="font-size: 18px; color: rgb(233, 223, 200); -unity-font-style: bold; white-space: normal;" />
                    <ui:Label text="Content students can actually understand — and checks that make sure no sentence is left behind."
                        style="font-size: 14px; color: rgb(152, 160, 174); white-space: normal; margin-top: 2%;" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ── Pager nav · ‹ dots › — centered, like turning a page ── -->
        <ui:VisualElement name="pager-nav"
            style="flex-shrink: 0; flex-direction: row; justify-content: center; align-items: center; padding-top: 8px; padding-bottom: 10px;">
            <ui:Button name="pager-prev" text="‹"
                style="width: 44px; height: 44px; background-color: rgb(35, 39, 51); color: rgb(233, 223, 200); font-size: 22px; -unity-font-style: bold; border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-left-radius: 22px; border-bottom-right-radius: 22px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 0; margin-right: 0;" />
            <ui:VisualElement name="pager-dots"
                style="flex-direction: row; align-items: center; margin-left: 14px; margin-right: 14px;" />
            <ui:Button name="pager-next" text="›"
                style="width: 44px; height: 44px; background-color: rgb(35, 39, 51); color: rgb(233, 223, 200); font-size: 22px; -unity-font-style: bold; border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-left-radius: 22px; border-bottom-right-radius: 22px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 0; margin-right: 0;" />
        </ui:VisualElement>

        <!-- ── Zone 3 · Bottom bar — 9% of screen height ── -->
        <ui:VisualElement name="bottom-bar"
            style="height: 9%; flex-shrink: 0; justify-content: center; align-items: center; border-top-width: 1px; border-top-color: rgb(35, 39, 51);">
            <ui:VisualElement name="links-row" style="flex-direction: row; align-items: center;">
                <ui:Button name="about-button" text="About Us"
                    style="background-color: rgba(0, 0, 0, 0); color: rgb(233, 223, 200); font-size: 14px; -unity-font-style: bold; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 0; padding-right: 4px; margin-left: 0; margin-right: 0;" />
                <ui:Label text="·" style="color: rgb(90, 97, 110); font-size: 14px;" />
                <ui:Button name="contact-button" text="Contact Us"
                    style="background-color: rgba(0, 0, 0, 0); color: rgb(233, 223, 200); font-size: 14px; -unity-font-style: bold; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 4px; padding-right: 0; margin-left: 0; margin-right: 0;" />
            </ui:VisualElement>
            <ui:Label name="footer" text="sReader · read anywhere"
                style="color: rgb(90, 97, 110); font-size: 12px; letter-spacing: 2px; margin-top: 1%;" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
