<?xml version="1.0" encoding="utf-8"?>
<!--
    sReader — Register Page v4 (Huawei Y5 · 720×1520 · relative units)
    ───────────────────────────────────────────────────────────────────
    Multi-step form, paged sideways like a game — no scrolling:
        Header      16%  of screen height
        Steps       flex-grow:1 — one centered step at a time
                    (pager-pages / UIPager.cs; ‹ › arrows + dots below)
            Step 1  About you  — names, email, social shortcut
            Step 2  Secure your account — password + confirm
            Step 3  Finish up  — terms + create account
        Bottom bar   9%  of screen height
    "›" validates the current step before advancing
    (RegisterPageController.ValidateStep). The shared error label sits
    above the pager nav so it is visible on every step.
    px values (fonts, field/button heights, radii, hairlines) are
    authored against the PanelSettings reference resolution of 360×800.
    placeholder-text requires Unity 2023.1+.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">

    <!-- Cursor/selection colors for text inputs (C# setters are obsolete) -->
    <ui:Style src="project://database/Assets/Scripts/UI/Views/Shared/AuthFields.uss" />

    <!-- Page root: fills the panel completely -->
    <ui:VisualElement name="page-root"
        style="width: 100%; height: 100%; background-color: rgb(18, 20, 25); padding-left: 6%; padding-right: 6%; padding-top: 3%; padding-bottom: 1.5%;">

        <!-- ── Zone 1 · Header ── -->
        <ui:VisualElement name="header"
            style="flex-shrink: 0; justify-content: flex-end; align-items: center; padding-top: 52px; padding-bottom: 14px;">

            <!-- Back button hanging in the top-left corner -->
            <ui:Button name="back-button" text="‹ Back"
                style="position: absolute; top: 8px; left: 0; background-color: rgba(0, 0, 0, 0); color: rgb(233, 223, 200); font-size: 16px; -unity-font-style: bold; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 0; padding-right: 16px; padding-top: 10px; padding-bottom: 10px; margin-left: 0;" />

            <!-- Signature bookmark ribbon hanging from the top edge -->
            <ui:VisualElement name="bookmark-ribbon"
                style="position: absolute; top: 0; right: 2%; width: 4.5%; height: 44px; background-color: rgb(233, 223, 200); border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;" />

            <ui:Label name="wordmark" text="sReader"
                style="font-size: 36px; color: rgb(242, 239, 230); -unity-font-style: bold; letter-spacing: 3px;" />
            <ui:VisualElement name="title-rule"
                style="height: 1px; width: 11%; background-color: rgb(233, 223, 200); margin-top: 1.5%; margin-bottom: 2%;" />
            <ui:Label name="subtitle" text="Begin your next chapter — create an account."
                style="font-size: 14px; color: rgb(152, 160, 174); -unity-text-align: middle-center; white-space: normal;" />
        </ui:VisualElement>

        <!-- ── Zone 2 · Form steps — one centered step at a time ── -->
        <ui:VisualElement name="pager-pages" style="flex-grow: 1;">

            <!-- Step 1 · About you -->
            <ui:VisualElement name="step-identity" style="flex-grow: 1; justify-content: center;">

                <ui:Label text="About you"
                    style="font-size: 26px; color: rgb(242, 239, 230); -unity-font-style: bold; margin-bottom: 6%;" />

                <ui:VisualElement name="name-row" style="height: 48px; flex-direction: row; margin-bottom: 4%;">
                    <ui:TextField name="first-name" placeholder-text="First name"
                        style="flex-grow: 1; flex-basis: 0; height: 100%; margin-left: 0; margin-right: 2%; justify-content: center; background-color: rgb(35, 39, 51); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 2%; padding-right: 2%; color: rgb(242, 239, 230); font-size: 16px;" />
                    <ui:TextField name="last-name" placeholder-text="Last name"
                        style="flex-grow: 1; flex-basis: 0; height: 100%; margin-left: 2%; margin-right: 0; justify-content: center; background-color: rgb(35, 39, 51); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 2%; padding-right: 2%; color: rgb(242, 239, 230); font-size: 16px;" />
                </ui:VisualElement>

                <ui:TextField name="email" placeholder-text="Email address" keyboard-type="EmailAddress"
                    style="height: 48px; margin-left: 0; margin-right: 0; margin-bottom: 6%; justify-content: center; background-color: rgb(35, 39, 51); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 2%; padding-right: 2%; color: rgb(242, 239, 230); font-size: 16px;" />

                <ui:Label text="I am a…"
                    style="font-size: 14px; color: rgb(152, 160, 174); margin-bottom: 2%;" />
                <ui:VisualElement name="role-row" style="height: 44px; flex-direction: row; margin-bottom: 6%;">
                    <ui:Button name="role-student" text="Student"
                        style="flex-grow: 1; flex-basis: 0; height: 100%; margin-left: 0; margin-right: 1.5%; background-color: rgb(233, 223, 200); color: rgb(18, 20, 25); font-size: 14px; -unity-font-style: bold; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(233, 223, 200); border-right-color: rgb(233, 223, 200); border-top-color: rgb(233, 223, 200); border-bottom-color: rgb(233, 223, 200);" />
                    <ui:Button name="role-guardian" text="Guardian"
                        style="flex-grow: 1; flex-basis: 0; height: 100%; margin-left: 1.5%; margin-right: 1.5%; background-color: rgba(0, 0, 0, 0); color: rgb(242, 239, 230); font-size: 14px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64);" />
                    <ui:Button name="role-tutor" text="Tutor"
                        style="flex-grow: 1; flex-basis: 0; height: 100%; margin-left: 1.5%; margin-right: 0; background-color: rgba(0, 0, 0, 0); color: rgb(242, 239, 230); font-size: 14px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64);" />
                </ui:VisualElement>

                <ui:VisualElement name="divider-row" style="flex-direction: row; align-items: center; margin-bottom: 6%;">
                    <ui:VisualElement style="flex-grow: 1; height: 1px; background-color: rgb(46, 51, 64);" />
                    <ui:Label text="or continue with" style="color: rgb(122, 130, 145); font-size: 14px; margin-left: 2%; margin-right: 2%;" />
                    <ui:VisualElement style="flex-grow: 1; height: 1px; background-color: rgb(46, 51, 64);" />
                </ui:VisualElement>

                <ui:VisualElement name="social-row" style="height: 48px; flex-direction: row;">
                    <ui:Button name="google-button" text="Google"
                        style="flex-grow: 1; flex-basis: 0; height: 100%; margin-left: 0; margin-right: 2%; background-color: rgba(0, 0, 0, 0); color: rgb(242, 239, 230); font-size: 16px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64);" />
                    <ui:Button name="apple-button" text="Apple"
                        style="flex-grow: 1; flex-basis: 0; height: 100%; margin-left: 2%; margin-right: 0; background-color: rgba(0, 0, 0, 0); color: rgb(242, 239, 230); font-size: 16px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64);" />
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Step 2 · Secure your account -->
            <ui:VisualElement name="step-security" style="flex-grow: 1; justify-content: center; display: none;">

                <ui:Label text="Secure your account"
                    style="font-size: 26px; color: rgb(242, 239, 230); -unity-font-style: bold; margin-bottom: 6%;" />

                <ui:TextField name="password" placeholder-text="Password" password="true"
                    style="height: 48px; margin-left: 0; margin-right: 0; margin-bottom: 4%; justify-content: center; background-color: rgb(35, 39, 51); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 2%; padding-right: 2%; color: rgb(242, 239, 230); font-size: 16px;" />

                <ui:TextField name="confirm-password" placeholder-text="Confirm password" password="true"
                    style="height: 48px; margin-left: 0; margin-right: 0; margin-bottom: 4%; justify-content: center; background-color: rgb(35, 39, 51); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 2%; padding-right: 2%; color: rgb(242, 239, 230); font-size: 16px;" />

                <ui:Label name="password-hint" text="Use 8+ characters with at least one number."
                    style="font-size: 14px; color: rgb(122, 130, 145); white-space: normal;" />

            </ui:VisualElement>

            <!-- Step 3 · Finish up -->
            <ui:VisualElement name="step-finish" style="flex-grow: 1; justify-content: center; display: none;">

                <ui:Label text="Finish up"
                    style="font-size: 26px; color: rgb(242, 239, 230); -unity-font-style: bold; margin-bottom: 6%;" />

                <ui:Toggle name="terms-toggle" text=" I agree to the Terms of Service and Privacy Policy"
                    style="margin-left: 0; margin-bottom: 8%; color: rgb(152, 160, 174); font-size: 14px;" />

                <ui:Button name="register-button" text="Create account"
                    style="height: 52px; background-color: rgb(233, 223, 200); color: rgb(18, 20, 25); font-size: 16px; -unity-font-style: bold; letter-spacing: 1px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;" />

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Shared error slot — visible on every step, above the pager nav -->
        <ui:Label name="error-label" text=""
            style="flex-shrink: 0; font-size: 14px; color: rgb(224, 122, 113); -unity-text-align: middle-center; white-space: normal; display: none; margin-bottom: 6px;" />

        <!-- ── Pager nav · ‹ dots › — "›" validates the step first ── -->
        <ui:VisualElement name="pager-nav"
            style="flex-shrink: 0; flex-direction: row; justify-content: center; align-items: center; padding-top: 8px; padding-bottom: 10px;">
            <ui:Button name="pager-prev" text="‹"
                style="width: 44px; height: 44px; background-color: rgb(35, 39, 51); color: rgb(233, 223, 200); font-size: 22px; -unity-font-style: bold; border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-left-radius: 22px; border-bottom-right-radius: 22px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 0; margin-right: 0;" />
            <ui:VisualElement name="pager-dots"
                style="flex-direction: row; align-items: center; margin-left: 14px; margin-right: 14px;" />
            <ui:Button name="pager-next" text="›"
                style="width: 44px; height: 44px; background-color: rgb(35, 39, 51); color: rgb(233, 223, 200); font-size: 22px; -unity-font-style: bold; border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-left-radius: 22px; border-bottom-right-radius: 22px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 0; margin-right: 0;" />
        </ui:VisualElement>

        <!-- ── Zone 3 · Bottom bar — 9% of screen height ── -->
        <ui:VisualElement name="bottom-bar"
            style="height: 9%; flex-shrink: 0; justify-content: center; align-items: center; border-top-width: 1px; border-top-color: rgb(35, 39, 51);">
            <ui:VisualElement name="signin-row" style="flex-direction: row; align-items: center;">
                <ui:Label text="Already a reader?" style="color: rgb(152, 160, 174); font-size: 14px;" />
                <ui:Button name="signin-button" text="Sign in"
                    style="background-color: rgba(0, 0, 0, 0); color: rgb(233, 223, 200); font-size: 14px; -unity-font-style: bold; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 4px; padding-right: 0; margin-left: 2px; margin-right: 0;" />
            </ui:VisualElement>
            <ui:Label name="footer" text="sReader · read anywhere"
                style="color: rgb(90, 97, 110); font-size: 12px; letter-spacing: 2px; margin-top: 1%;" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
