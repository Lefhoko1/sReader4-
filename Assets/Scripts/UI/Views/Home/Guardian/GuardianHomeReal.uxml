<?xml version="1.0" encoding="utf-8"?>
<!--
    sReader — Guardian Home (post-login landing for Guardian accounts)
    ──────────────────────────────────────────────────────────────────
    Element names are read by GuardianHomeController:
        greeting, home-title, home-tagline,
        my-students-button, progress-button, link-student-button,
        profile-button, signout-button.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">

    <ui:VisualElement name="page-root"
        style="width: 100%; height: 100%; background-color: rgb(18, 20, 25); padding-left: 6%; padding-right: 6%; padding-top: 3%; padding-bottom: 1.5%;">

        <!-- ── Zone 1 · Header ── -->
        <ui:VisualElement name="header"
            style="flex-shrink: 0; justify-content: flex-end; align-items: flex-start; padding-top: 52px; padding-bottom: 14px;">
            <ui:VisualElement name="bookmark-ribbon"
                style="position: absolute; top: 0; right: 2%; width: 4.5%; height: 44px; background-color: rgb(233, 223, 200); border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;" />
            <ui:Label name="wordmark" text="sReader"
                style="font-size: 30px; color: rgb(242, 239, 230); -unity-font-style: bold; letter-spacing: 3px;" />
            <ui:VisualElement name="title-rule"
                style="height: 1px; width: 11%; background-color: rgb(233, 223, 200); margin-top: 1.5%; margin-bottom: 3%;" />
            <ui:Label name="greeting" text="Welcome"
                style="font-size: 22px; color: rgb(242, 239, 230); -unity-font-style: bold; white-space: normal;" />
        </ui:VisualElement>

        <!-- ── Zone 2 · Body ── -->
        <ui:VisualElement name="body" style="flex-grow: 1; justify-content: flex-start; padding-top: 4%;">

            <ui:Label name="home-title" text="Guardian dashboard"
                style="font-size: 18px; color: rgb(233, 223, 200); -unity-font-style: bold; margin-bottom: 1.5%;" />
            <ui:Label name="home-tagline" text=""
                style="font-size: 14px; color: rgb(152, 160, 174); white-space: normal; margin-bottom: 8%;" />

            <ui:Button name="my-students-button" text="My students"
                style="height: 56px; margin-bottom: 4%; background-color: rgb(233, 223, 200); color: rgb(18, 20, 25); font-size: 16px; -unity-font-style: bold; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;" />
            <ui:Button name="progress-button" text="Progress &amp; reports"
                style="height: 56px; margin-bottom: 4%; background-color: rgb(35, 39, 51); color: rgb(242, 239, 230); font-size: 16px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64);" />
            <ui:Button name="link-student-button" text="Link a student"
                style="height: 56px; background-color: rgb(35, 39, 51); color: rgb(242, 239, 230); font-size: 16px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(46, 51, 64); border-right-color: rgb(46, 51, 64); border-top-color: rgb(46, 51, 64); border-bottom-color: rgb(46, 51, 64);" />

        </ui:VisualElement>

        <!-- ── Zone 3 · Bottom bar ── -->
        <ui:VisualElement name="bottom-bar"
            style="height: 9%; flex-shrink: 0; flex-direction: row; justify-content: center; align-items: center; border-top-width: 1px; border-top-color: rgb(35, 39, 51);">
            <ui:Button name="profile-button" text="Profile"
                style="background-color: rgba(0, 0, 0, 0); color: rgb(233, 223, 200); font-size: 14px; -unity-font-style: bold; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 8px; padding-right: 8px; margin-right: 8px;" />
            <ui:Label text="·" style="color: rgb(90, 97, 110); font-size: 14px;" />
            <ui:Button name="signout-button" text="Sign out"
                style="background-color: rgba(0, 0, 0, 0); color: rgb(152, 160, 174); font-size: 14px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; padding-left: 8px; padding-right: 8px; margin-left: 8px;" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
